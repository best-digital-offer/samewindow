# GEMINI_API_KEY: server-side AI Studio key
GEMINI_API_KEY=""

# GROQ_API_KEY: optional server-side key for failure analysis
GROQ_API_KEY=""

# Supabase browser client
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase server-only key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Encryption key for sensitive project tokens
SAMEWINDOW_ENCRYPTION_KEY="32_byte_hex_key_here"

# Stripe Billing (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# App URL
APP_URL="http://localhost:3000"
